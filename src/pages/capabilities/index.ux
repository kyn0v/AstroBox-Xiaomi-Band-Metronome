<template>
  <div class="page" ontouchstart="onPageTouchStart" ontouchmove="onPageTouchMove" ontouchend="onPageTouchEnd">
    <div class="content" if="{{ !detailVisible }}">
      <text class="title">{{ labels.title }}</text>
      <text class="subtitle">{{ panelTitle }}</text>
      <text class="status">{{ status }}</text>
      <div class="rows">
        <div class="result" for="{{ rows }}" tid="id" onclick="showDetail($item.id)">
          <text class="label">{{ $item.label }}</text>
          <text class="value">{{ $item.value }}</text>
        </div>
      </div>
      <text class="note">{{ note }}</text>
      <div class="pager">
        <input class="nav" type="button" value="{{ labels.previous }}" disabled="{{ pageIndex === 0 }}" onclick="previousPage" />
        <text class="counter">{{ pageCounter }}</text>
        <input class="nav" type="button" value="{{ labels.next }}" disabled="{{ pageIndex === pageCount - 1 }}" onclick="nextPage" />
      </div>
      <div class="actions">
        <input class="action" type="button" value="{{ labels.recheck }}" disabled="{{ loading }}" onclick="recheck" />
        <input class="action" type="button" value="{{ labels.back }}" onclick="goBack" />
      </div>
    </div>
    <div class="content detail" if="{{ detailVisible }}">
      <text class="title">{{ labels.title }}</text>
      <text class="detail-label">{{ detailTitle }}</text>
      <text class="detail-value">{{ detailValue }}</text>
      <text class="note">{{ labels.detailNote }}</text>
      <input class="close" type="button" value="{{ labels.close }}" onclick="closeDetail" />
    </div>
  </div>
</template>

<script>
const app = require('@system.app')
const configuration = require('@system.configuration')
const router = require('@system.router')
let device = null
try { device = require('@system.device') } catch (error) {}
const { collectBackgroundCapabilities } = require('../../common/background-capabilities')
const { getCapabilityStrings } = require('../../common/capability-strings')
const { buildCapabilityPages, capabilityStatus, wrapCapabilityDetail } = require('../../common/capability-view')
const { createPageSwipe } = require('../../common/page-swipe')

export default {
  private: {
    labels: getCapabilityStrings('en'), loading: false, pageIndex: 0, pageCount: 5,
    rows: [], panelTitle: '', pageCounter: '', status: '', note: '',
    detailVisible: false, detailTitle: '', detailValue: ''
  },
  onInit() {
    this._visible = false
    this._navigating = false
    this._generation = 0
    this._cancel = null
    this._report = null
    this._needsQuery = true
    this._swipe = createPageSwipe(() => Date.now())
    this.refreshLanguage()
  },
  onShow() {
    this._visible = true
    this._navigating = false
    this._swipe.cancel()
    // No retained vibration experiment may overlap the read-only check.
    this.$app.$def.stopBackgroundProbe()
    this.refreshLanguage()
    if (this._needsQuery || !this._report) this.recheck()
    else this.render()
  },
  refreshLanguage() {
    let language = 'en'
    try { language = configuration.getLocale().language } catch (error) {}
    this.labels = getCapabilityStrings(language)
    this.render()
  },
  onConfigurationChanged() { this.detailVisible = false; this.refreshLanguage() },
  render() {
    this._pages = buildCapabilityPages(this._report, this.labels)
    this.pageCount = this._pages.length
    this.pageIndex = Math.max(0, Math.min(this.pageIndex, this.pageCount - 1))
    const panel = this._pages[this.pageIndex]
    this.rows = panel.rows
    this.panelTitle = panel.title
    this.note = panel.note
    this.pageCounter = (this.pageIndex + 1) + ' / ' + this.pageCount
    this.status = this.loading ? this.labels.reading : capabilityStatus(this._report, this.labels)
  },
  canInteract(fromGesture) {
    return this._visible && !this._navigating && (fromGesture === true || this._swipe.canClick())
  },
  cancelQuery() {
    this._generation++
    if (this._cancel) this._cancel()
    this._cancel = null
    this.loading = false
  },
  recheck() {
    if (!this.canInteract() || this.loading) return
    this.cancelQuery()
    this.loading = true
    this._needsQuery = true
    this.detailVisible = false
    this.render()
    const token = this._generation
    const cancel = collectBackgroundCapabilities({ app, device,
      clock: { setTimeout: (fn, ms) => setTimeout(fn, ms), clearTimeout: id => clearTimeout(id) }
    }, report => {
      if (!this._visible || this._navigating || token !== this._generation) return
      this._report = report
      this._needsQuery = false
      this.loading = false
      this._cancel = null
      this.render()
    })
    // Native APIs may finish synchronously, before the cancellation handle exists.
    if (this.loading && this._visible && token === this._generation) this._cancel = cancel
    else cancel()
  },
  previousPage(fromGesture) {
    if (!this.canInteract(fromGesture) || this.detailVisible) return
    this.pageIndex = Math.max(0, this.pageIndex - 1)
    this.render()
  },
  nextPage(fromGesture) {
    if (!this.canInteract(fromGesture) || this.detailVisible) return
    this.pageIndex = Math.min(this.pageCount - 1, this.pageIndex + 1)
    this.render()
  },
  showDetail(id) {
    if (!this.canInteract() || this.loading) return
    const row = this.rows.find(item => item.id === id)
    if (!row) return
    this.detailTitle = row.id.indexOf('@') === 0 ? row.id : row.label
    this.detailValue = wrapCapabilityDetail(row.value)
    this.detailVisible = true
  },
  closeDetail(fromGesture) {
    if (this.canInteract(fromGesture)) this.detailVisible = false
  },
  goBack(fromGesture) {
    if (!this.canInteract(fromGesture)) return
    if (this.detailVisible) { this.closeDetail(true); return }
    this._navigating = true
    this.cancelQuery()
    try { router.back() }
    catch (error) { this._navigating = false; this.render() }
  },
  onBackPress() {
    if (this.detailVisible) { this.detailVisible = false; return true }
    if (this._navigating) return true
    this._navigating = true
    this.cancelQuery()
    return false
  },
  onPageTouchStart(event) { this._swipe.start(event) },
  onPageTouchMove(event) { this._swipe.move(event) },
  onPageTouchEnd(event) {
    const direction = this._swipe.end(event)
    if (direction === 'right') this.goBack(true)
    else if (direction === 'left') this.nextPage(true)
  },
  onHide() {
    this._visible = false
    this.cancelQuery()
    this._swipe.cancel()
  },
  onDestroy() { this.onHide(); this._report = null; this._needsQuery = true }
}
</script>

<style>
.page { width: 100%; height: 100%; background-color: #10151e; }
.content { width: 100%; height: 100%; padding: 12px 18px; flex-direction: column; align-items: center; justify-content: space-between; }
.title { width: 300px; height: 26px; color: #f1f5f9; font-size: 20px; text-align: center; }
.subtitle { width: 300px; height: 24px; color: #68e3b8; font-size: 18px; text-align: center; }
.status { width: 300px; height: 24px; color: #c8d1dc; font-size: 15px; text-align: center; }
.rows { width: 300px; height: 216px; flex-shrink: 0; flex-direction: column; }
.result { width: 300px; height: 54px; flex-shrink: 0; flex-direction: column; }
.label { width: 300px; height: 18px; color: #a8b5c5; font-size: 14px; }
.value { width: 300px; height: 36px; color: #f1f5f9; font-size: 18px; }
.note { width: 300px; height: 32px; color: #e0cb87; font-size: 14px; text-align: center; }
.pager { width: 300px; height: 40px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; }
.nav { width: 92px; height: 36px; border-radius: 12px; background-color: #243041; color: #f1f5f9; font-size: 16px; }
.counter { width: 80px; height: 24px; color: #a8b5c5; font-size: 16px; text-align: center; }
.actions { width: 300px; height: 36px; flex-shrink: 0; flex-direction: row; justify-content: space-between; }
.action { width: 144px; height: 36px; border-radius: 12px; background-color: #243041; color: #f1f5f9; font-size: 16px; }
.detail-label { width: 280px; height: 48px; color: #68e3b8; font-size: 18px; text-align: center; }
.detail-value { width: 280px; height: 240px; color: #f1f5f9; font-size: 20px; text-align: center; }
.close { width: 280px; height: 40px; border-radius: 12px; background-color: #243041; color: #f1f5f9; font-size: 18px; }
</style>
